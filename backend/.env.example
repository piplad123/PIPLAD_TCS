# PostgreSQL connection string (required)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=

# Cloudinary media storage (required for admin uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of allowed browser origins (CORS):
# CORS_ORIGINS=http://localhost:5173,https://www.pip-dev.in,https://pip-found.pages.dev,https://pip-dev.onrender.com

# Razorpay (leave blank to use simulated mock orders)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Mode: 'test' | 'live' | 'mock' (blank => derived from key prefix:
#   rzp_live_ => live, rzp_test_ => test, anything else => mock)
RAZORPAY_MODE=
# Webhook secret from Razorpay Dashboard > Settings > Webhooks.
# Zeros keys (test AND live) now run the REAL Razorpay Checkout popup.
RAZORPAY_WEBHOOK_SECRET=

# Admin API basic auth credentials (override defaults)
# ADMIN_USER=
# ADMIN_PASSWORD=

# Email (used for volunteer welcome cards and 80G donation receipts)
#
# Production uses the Brevo HTTPS API because Render's free tier blocks
# outbound SMTP ports (25/465/587). Create a free account at Brevo, add a
# Single Sender Verification for your "from" address, then generate an API key
# at Settings > SMTP & API > API Keys.
# BREVO_API_KEY=
# EMAIL_FROM=            (verified sender; e.g. youraddress@gmail.com)
# EMAIL_FROM_NAME=Piplad Welfare Foundation

# Contact footer shown in the volunteer welcome e-mail.
# CONTACT_WEBSITE=https://www.pipladfoundation.in
# CONTACT_EMAIL=info@pipladfoundation.in
# CONTACT_PHONE=        (optional; line is omitted when blank)

# Public frontend base URL used to build the QR codes on certificates and
# Volunteer ID cards (e.g. https://www.pipladfoundation.in in production).
# QR codes always encode this value followed by /verify/certificate/<id> or
# /verify/volunteer/<id>. When blank the Render-hosted frontend
# (https://pip-dev.onrender.com) is used.
# PUBLIC_FRONTEND_URL=https://www.pipladfoundation.in